# Copy to .env and fill in values before running with --mode live.
#
# Benchmark mode:
#   sim  — deterministic local harness (default; no API keys required)
#   live — real provider HTTP calls; set keys below
#
# CLI flag --mode overrides DYNO_MODE when both are set.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenAI-compatible endpoint (vLLM, Ollama, DeepSeek, OpenRouter, etc.)
OPENAI_BASE_URL=

# Default when --mode is omitted: sim (any value other than "live" is treated as sim)
DYNO_MODE=sim
